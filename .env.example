# Local settings for this repo: kippm and its libraries come from the org's Gitea PyPI index.
# Same variables CI sets from the GITEA_PYPI_* secrets, so local and CI resolve identically.
#
#   cp .env.example .env      # fill in; .env is git-ignored
#   set -a; . ./.env; set +a  # or `dotenv` in a direnv .envrc
#   uv sync
#
# Token: Gitea > Settings > Applications, package read access (write only to publish by hand).

UV_INDEX=inkr=https://gitea.insleker.org/api/packages/inkr_org/pypi/simple/
UV_INDEX_INKR_USERNAME=your-gitea-username
UV_INDEX_INKR_PASSWORD=your-gitea-token

# publish by hand (`uv build && uv publish`); releases normally go through a vX.Y.Z tag
# UV_PUBLISH_URL=https://gitea.insleker.org/api/packages/inkr_org/pypi
# UV_PUBLISH_USERNAME=your-gitea-username
# UV_PUBLISH_PASSWORD=your-gitea-token
