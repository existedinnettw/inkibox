# Local settings for publishing inkibox by hand (releases normally go through a vX.Y.Z tag,
# release.yml, GITEA_PYPI_* secrets). Developing needs none of this: every dependency is on
# PyPI.
#
#   cp .env.example .env      # fill in; .env is git-ignored
#   set -a; . ./.env; set +a
#   uv build && uv publish
#
# Token: Gitea > Settings > Applications, package write access.

UV_PUBLISH_URL=https://gitea.insleker.org/api/packages/inkr_org/pypi
UV_PUBLISH_USERNAME=your-gitea-username
UV_PUBLISH_PASSWORD=your-gitea-token
